# =============================================================================
# BirdPump Backend Env
# Copy to .env.local for dev. In production, set these in Vercel Project Settings.
# NEVER commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Solana network + RPC
# -----------------------------------------------------------------------------
SOLANA_CLUSTER=mainnet-beta
HELIUS_API_KEY=
# Optional — if unset, derived from HELIUS_API_KEY
SOLANA_RPC_URL=
SOLANA_RPC_FALLBACK=https://api.mainnet-beta.solana.com

# -----------------------------------------------------------------------------
# PUMPBIRD token
# -----------------------------------------------------------------------------
# Set this AFTER you launch $PUMPBIRD on pump.fun.
# Until set, /api/entry/quote returns 503 price_unavailable.
PUMPBIRD_TOKEN_MINT=
# pump.fun tokens are 6 decimals by default
PUMPBIRD_TOKEN_DECIMALS=6
# pump.fun program ID (default is the canonical mainnet one)
PUMPFUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# -----------------------------------------------------------------------------
# Treasury wallet — holds pot + treasury reserve + signs winner payouts
# Generate via: npm run treasury:keygen
# -----------------------------------------------------------------------------
TREASURY_SECRET_KEY=
NEXT_PUBLIC_TREASURY_ADDRESS=

# -----------------------------------------------------------------------------
# Pot economics
# -----------------------------------------------------------------------------
# Entry fee in USD cents (default 100 = $1)
ENTRY_USD_CENTS=100
# Burn/buyback cut in basis points (2500 = 25%). Goes to treasury reserve.
BURN_CUT_BPS=2500
# Slippage tolerance for entry payments in bps (300 = 3%)
SLIPPAGE_BPS=300
# Quote lifetime in ms — pump.fun is fast, keep it tight
QUOTE_TTL_MS=10000

# -----------------------------------------------------------------------------
# Treasury safety
# -----------------------------------------------------------------------------
# Minimum SOL kept in treasury to pay tx fees (cron warns when below)
MIN_GAS_SOL=0.05
# Optional cap on PUMPBIRD token balance — 0 to disable.
# Used for cold-storage sweep alerts. Set in raw token units (with decimals).
HOT_WALLET_CAP_TOKENS=0

# -----------------------------------------------------------------------------
# Birdeye (BundlerBot) — SOL/USD + post-graduation token price fallback
# -----------------------------------------------------------------------------
BIRDEYE_API_KEY=
SOL_USD_CACHE_TTL=30
SOL_USD_FALLBACK=150

# -----------------------------------------------------------------------------
# Database — Vercel Postgres (Neon serverless)
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Upstash Redis
# -----------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=

# -----------------------------------------------------------------------------
# Auth (SIWS)
# -----------------------------------------------------------------------------
# Generate: openssl rand -hex 48
JWT_SECRET=
JWT_TTL_SECONDS=86400
SIWS_NONCE_TTL=300
SIWS_DOMAIN=birdpump.fun

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Cron / webhook auth
# -----------------------------------------------------------------------------
CRON_SECRET=
HELIUS_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Anti-cheat thresholds
# -----------------------------------------------------------------------------
MAX_PLAUSIBLE_SCORE=500
MAX_TAPS_PER_SECOND=40
MIN_PLAY_DURATION_MS=2000
