    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.1",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
