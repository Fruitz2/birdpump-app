{
  "name": "birdpump-backend",
  "version": "0.1.0",
  "private": true,
  "description": "BirdPump game backend \u2014 PumpBird-on-Solana paid entry, server-side replay, winner-takes-pot. Vercel-only.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
