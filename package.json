    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "treasury:balance": "tsx scripts/treasury-balance.ts",
    "treasury:keygen": "tsx scripts/treasury-keygen.ts",
    "avatars:generate": "tsx scripts/generate-avatars.ts",
    "launch": "tsx scripts/launch.ts",
    "launch:check": "tsx scripts/launch.ts --check",
    "launch:verify": "tsx scripts/launch-verify.ts",
    "refund:list": "tsx scripts/refund-mispaid.ts --list",
    "refund:mispaid": "tsx scripts/refund-mispaid.ts"
